{
    "name": "webware/generic-testing",
    "description": "Generic testing utilities for Webware",
    "license": "BSD-3-Clause",
    "keywords": [
        "webware",
        "testing"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        },
        "allow-plugins": {
            "laminas/laminas-component-installer": true,
            "composer/package-versions-deprecated": true
        }
    },
    "extra": {
        "laminas": {
            "config-provider": "Webware\\Test\\ConfigProvider"
        }
    },
    "require": {
        "php": "~8.4.1 || ~8.5.0",
        "psr/container": "^2.0",
        "php-standard-library/type": "^6.2.1"
    },
    "require-dev": {
        "laminas/laminas-config-aggregator": "1.20.0",
        "laminas/laminas-servicemanager": "^4.0.0",
        "laminas/laminas-validator": "^3.17",
        "phpunit/phpunit": "^13.2.0",
        "roave/security-advisories": "dev-master"
    },
    "suggest": {
        "laminas/laminas-servicemanager": "Laminas\\ServiceManager component"
    },
    "autoload": {
        "psr-4": {
            "Webware\\Test\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebwareTest\\CommandBusTest\\": "test/unit/",
            "WebwareIntegrationTest\\CommandBusIntegrationTest\\": "test/integration/"
        }
    },
    "scripts": {
        "test-all": [
            "@test",
            "@test-integration"
        ],
        "test": "phpunit --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "test-integration": "phpunit --colors=always --testsuite \"integration test\"",
        "upload-coverage": "coveralls -v"
    }
}
